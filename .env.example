# Contact form (Web3Forms) — create a free access key at https://web3forms.com
# using info@churchgeniuspro.com, then copy this file to .env
VITE_WEB3FORMS_KEY=your-access-key-here

# "Continue with Google" on /demo — the OAuth *Web client ID* from Google Cloud
# Console (APIs & Services → Credentials). Public by design; no secret here.
# Leave blank to hide the Google button (email registration still works).
VITE_GOOGLE_CLIENT_ID=

# The managed functions (api/) read these from the Static Web App's
# Environment variables in the Azure Portal, not from this file:
#   DEMO_SESSION_SECRET, GOOGLE_CLIENT_ID, STORAGE_CONNECTION_STRING,
#   BREVO_API_KEY, BREVO_SENDER (see README → Required Configuration).
